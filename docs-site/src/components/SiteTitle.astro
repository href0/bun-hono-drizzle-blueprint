---
/*
 * Starlight's site title plus the version of this project (D45): read from the root package.json
 * at build time, so a project created from the boilerplate shows its own version.
 */
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import packageJson from '../../../package.json';
---

<div class="title-with-version">
  <Default />
  <span class="version" title="Version in package.json">v{packageJson.version}</span>
</div>

<style>
  .title-with-version {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }
  .version {
    flex-shrink: 0;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    line-height: 1.4;
  }
  @media (max-width: 30rem) {
    .version {
      display: none;
    }
  }
</style>
