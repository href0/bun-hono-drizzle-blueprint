FROM oven/bun:1.3.0-alpine
WORKDIR /app

# Install all dependencies (including devDependencies for dev/watcher)
COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile

# Expose server port
EXPOSE 3000

# Development server with watch mode; compose injects the variables (env_file: .env.dev), so the
# app runs directly instead of through bun run start:dev
CMD ["bun", "--watch", "src/index.ts"]
