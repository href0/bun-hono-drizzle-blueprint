{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.dev)",
      "Read(./.env.test)",
      "Read(./.env.ci)",
      "Read(./.env.stg)",
      "Read(./.env.staging)",
      "Read(./.env.prod)",
      "Read(./.env.production)",
      "Read(./.env.demo)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.dev)",
      "Edit(./.env.test)",
      "Edit(./.env.stg)",
      "Edit(./.env.demo)",
      "Edit(./.env.prod)",
      "Bash(bun run start:stg:*)",
      "Bash(bun run start:demo:*)",
      "Bash(bun run start:prod:*)",
      "Bash(bun run env stg:*)",
      "Bash(bun run env demo:*)",
      "Bash(bun run env prod:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob|Bash|PowerShell|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-env.mjs\""
          }
        ]
      }
    ]
  }
}
