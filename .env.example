# Each section maps to one validated group in src/config/<group>.config.ts.
# The app fails to start listing every invalid variable of the first failing group (names only, never values).

# --- app (src/config/app.config.ts) ---
NODE_ENV=development
PORT=3000
APP_NAME=bun-hono-starter
API_PREFIX=/api/v1
LOG_LEVEL=info

# --- database (src/config/database.config.ts) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starter_db
DB_SCHEMA=public
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_SECONDS=30

# --- redis (src/config/redis.config.ts) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Key Prefix — leave empty for standalone single-project deployment (default/recommended).
# Set this when multiple projects share one Redis instance to prevent key collisions.
# Recommended format: <app-name>:<environment>  (e.g., my-service:production)
REDIS_KEY_PREFIX=

# --- http (src/config/http.config.ts) ---
# Use '*' for development. For production, specify allowed origins (comma-separated).
# Example: https://myapp.com,https://admin.myapp.com
CORS_ORIGIN=*
# Window duration in milliseconds and max requests per window per client IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- integrations (src/config/integrations.config.ts) ---
JSONPLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com
JSONPLACEHOLDER_TIMEOUT_MS=10000

# --- docker compose only (not read by the app) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=starter_db
POSTGRES_PORT=5432
