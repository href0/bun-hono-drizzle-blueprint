# Each section maps to one validated group in src/config/<group>.config.ts.
# The app fails to start listing every invalid variable of the first failing group (names only, never values).

# --- app (src/config/app.config.ts) ---
NODE_ENV=development
PORT=3000
APP_NAME=bun-hono-drizzle-blueprint
# Unversioned API root (health at <base>/health); versions live in code, e.g. <base>/v1/users.
API_BASE_PATH=/api
LOG_LEVEL=info
# Language when Accept-Language is missing or unsupported: id | en
DEFAULT_LOCALE=id
# OpenAPI JSON + Scalar UI at <API_BASE_PATH>/docs. Unset = on, except in production. true | false
# API_DOCS_ENABLED=

# --- database (src/config/database.config.ts) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bun_hono_drizzle_blueprint_db
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_SECONDS=30

# --- redis (src/config/redis.config.ts) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Every key is prefixed. Empty = <APP_NAME>:<NODE_ENV> (e.g. my-service:production), so projects
# and environments sharing one Redis never collide. Override format: segment[:segment] (no trailing ':').
REDIS_KEY_PREFIX=
# A slower command fails and the cache fails open instead of stalling the request.
REDIS_COMMAND_TIMEOUT_MS=1000

# --- http (src/config/http.config.ts) ---
# Browser origins allowed to call the API with credentials (comma-separated, exact origins, no path).
# Empty = CORS disabled. '*' reflects any origin and is rejected when NODE_ENV=production.
# Example: https://app.example.com,http://localhost:5173
# Also the CSRF allowlist of the cookie endpoints (/auth/login, /auth/refresh, /auth/logout).
CORS_ORIGINS=
# Reverse proxies in front of the app (load balancer, ingress). 0 = use the socket address and
# ignore X-Forwarded-For; n = take the n-th X-Forwarded-For entry from the right.
TRUST_PROXY_HOPS=0
# Larger request bodies get 413 ERR_PAYLOAD_TOO_LARGE (default 1 MiB).
HTTP_BODY_LIMIT_BYTES=1048576
# Global fixed-window limit per client IP, shared through Redis (fails open when Redis is down).
# Sized for a signed-in SPA, also for many users behind one office / NAT IP.
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX=1000

# --- auth (src/config/auth.config.ts) ---
# HMAC key for access tokens, at least 32 characters. `bun run setup` fills it in a new local env file;
# elsewhere generate one: bun -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Empty = APP_NAME. Tokens from another issuer or for another audience are rejected.
JWT_ISSUER=
JWT_AUDIENCE=
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime, renewed on every rotation (7 days, at most 400 days = cookie limit);
# a session ends after the absolute TTL (30 days).
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_ABSOLUTE_TTL_SECONDS=2592000
# Strict | Lax | None. None only for a frontend on another site over HTTPS (the cookie is always Secure).
AUTH_COOKIE_SAMESITE=Strict
# Public sign-up endpoint; false = users are created by an admin.
AUTH_REGISTRATION_ENABLED=false
# Failed logins per (email, client IP) before a lock of AUTH_LOGIN_LOCK_SECONDS (429).
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_SECONDS=900

# --- partner (src/config/partner.config.ts) — inbound partner gateway ---
# How far x-partner-timestamp may be from the server clock, either way (5 minutes).
PARTNER_HMAC_TOLERANCE_MS=300000
# AES-256-GCM keys that encrypt partner HMAC secrets at rest: <id>:<64 hex>, comma-separated.
# `bun run setup` fills both in a new local env file; elsewhere generate a key:
# bun -e "console.log('k1:' + crypto.randomBytes(32).toString('hex'))"
# Rotation: add the new key (k2:…,k1:…) and make it active; new and rotated secrets use it. Keep the
# old key until every partner secret sealed with it has been rotated (secret-rotations endpoint).
# Losing every key makes stored partner secrets unreadable (all partners need new secrets).
PARTNER_SECRET_KEYS=
# The key that encrypts new and rotated secrets; must be one of PARTNER_SECRET_KEYS.
PARTNER_SECRET_ACTIVE_KEY_ID=

# --- jsonplaceholder (src/config/jsonplaceholder.config.ts) — one group per vendor ---
JSONPLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com
JSONPLACEHOLDER_TIMEOUT_MS=10000

# --- demo-pay (src/config/demo-pay.config.ts) — example webhook vendor (POST /api/webhooks/demo-pay) ---
# The signing secret from the vendor dashboard. Empty = Demo Pay webhooks are disabled (all 401).
DEMO_PAY_WEBHOOK_SECRET=
# Signed timestamps older (or newer) than this are refused as replays.
DEMO_PAY_WEBHOOK_TOLERANCE_SECONDS=300

# --- integration tests only (bun run test:int — scripts/test-integration.ts; not read by the app) ---
# An existing database on the test server: the runner creates and drops <name>_it_<run> from it.
# Unset = DATABASE_URL / REDIS_* above, but only with NODE_ENV=development|test and only when they
# point at this machine (localhost). Never needed on a server: the suite runs on developer machines and CI.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# TEST_REDIS_HOST=localhost
# TEST_REDIS_PORT=6379
# TEST_REDIS_PASSWORD=
# TEST_REDIS_DB=0

# --- docker compose only (not read by the app) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bun_hono_drizzle_blueprint_db
POSTGRES_PORT=5432
