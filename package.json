{
  "name": "bun-hono-drizzle-blueprint",
  "version": "1.0.0",
  "description": "Production-grade backend blueprint for Bun, Hono, Drizzle ORM and PostgreSQL",
  "type": "module",
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "lint:setup": "bun scripts/setup.ts registry-check --dry-run",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "test:unit": "bun test src/",
    "test:e2e": "bun test test/",
    "test:int": "bun scripts/test-integration.ts",
    "test:cov": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && bun scripts/check-coverage.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts --max-warnings 0",
    "lint:fix": "eslint src test scripts --fix",
    "lint:ls": "ls-lint",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "lint:deps": "knip",
    "lint:branch": "validate-branch-name",
    "verify:scaffold": "bun scripts/verify-scaffold.ts",
    "scaffold": "bun scripts/scaffold.ts",
    "scaffold:module": "bun scripts/scaffold.ts module",
    "scaffold:partner": "bun scripts/scaffold.ts partner",
    "scaffold:webhook": "bun scripts/scaffold.ts webhook",
    "scaffold:integration": "bun scripts/scaffold.ts integration",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "validate": "bun run typecheck && bun run lint && bun run lint:ls && bun run format:check && bun run lint:arch && bun run lint:deps && bun run lint:setup && bun run openapi:check && bun run lint:branch",
    "validate:full": "bun run validate && bun run test:cov",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "bun scripts/seed-admin.ts",
    "auth:purge-tokens": "bun scripts/purge-refresh-tokens.ts",
    "partner:sign": "bun scripts/partner-sign.ts",
    "openapi:check": "bun scripts/openapi.ts check",
    "openapi:update": "bun scripts/openapi.ts update",
    "docs:dev": "cd docs-site && bun run dev",
    "docs:build": "cd docs-site && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.12.9",
    "axios": "^1.8.2",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.13.9",
    "hono-openapi": "^1.3.3",
    "ioredis": "^5.6.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "temporal-polyfill": "^1.0.5",
    "zod": "^3.25.76",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.22.0",
    "@ls-lint/ls-lint": "^2.3.1",
    "@types/bun": "latest",
    "@types/node": "^22.13.10",
    "dependency-cruiser": "^16.10.0",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "validate-branch-name": "^1.3.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
